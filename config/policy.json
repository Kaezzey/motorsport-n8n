{
  "policy_id": "milestone-4-lap-context-gate-v1",
  "sensor_quality_profile_path": "./vehicle-profile.json",
  "lap_context_profile_path": "./lap-context-profile.json",
  "required_top_level": [
    "schema_version",
    "session_id",
    "lap_id",
    "purpose",
    "expected_sample_rate_hz",
    "units",
    "samples"
  ],
  "required_channels": [
    "timestamp_ms",
    "speed_kph",
    "throttle_pct",
    "brake_pressure_bar",
    "steering_deg",
    "rpm",
    "gear",
    "longitudinal_g",
    "lateral_g",
    "yaw_rate_deg_s",
    "wheel_speed_fl_kph",
    "wheel_speed_fr_kph",
    "wheel_speed_rl_kph",
    "wheel_speed_rr_kph"
  ],
  "units": {
    "timestamp_ms": "ms",
    "speed_kph": "km/h",
    "throttle_pct": "%",
    "brake_pressure_bar": "bar",
    "steering_deg": "deg",
    "rpm": "rpm",
    "gear": "index",
    "longitudinal_g": "g",
    "lateral_g": "g",
    "yaw_rate_deg_s": "deg/s",
    "wheel_speed_kph": "km/h"
  },
  "ranges": {
    "speed_kph": [0, 300],
    "throttle_pct": [-2, 107],
    "brake_pressure_bar": [-3, 120],
    "steering_deg": [-540, 540],
    "rpm": [0, 9500],
    "gear": [0, 7],
    "longitudinal_g": [-20, 20],
    "lateral_g": [-20, 20],
    "yaw_rate_deg_s": [-180, 180],
    "wheel_speed_fl_kph": [0, 320],
    "wheel_speed_fr_kph": [0, 320],
    "wheel_speed_rl_kph": [0, 320],
    "wheel_speed_rr_kph": [0, 320]
  },
  "thresholds": {
    "minimum_samples": 10,
    "sample_rate_tolerance_ratio": 0.15,
    "timestamp_jitter_ratio": 0.25,
    "maximum_missing_ratio": 0.01,
    "maximum_wheel_speed_delta_kph": 15,
    "minimum_brake_pressure_bar": 15,
    "minimum_braking_deceleration_g": -0.08,
    "warnings_before_review": 2
  },
  "hard_failure_checks": [
    "schema.required",
    "schema.version",
    "schema.purpose",
    "file.validation_reject",
    "samples.minimum",
    "timestamps.monotonic",
    "channels.missing",
    "units.canonical",
    "ranges.physical"
  ],
  "review_trigger_checks": [
    "manifest.review_required",
    "manifest.match_confidence",
    "file.validation_review",
    "signals.frozen_duration",
    "signals.derivative_rate",
    "signals.spikes",
    "signals.dropouts",
    "gps.validity",
    "context.segmentation",
    "context.classification_confidence",
    "context.reference_agreement",
    "context.abnormal_events"
  ],
  "file_validation": {
    "timestamp_gap_multiplier": 5,
    "maximum_malformed_row_ratio": 0,
    "maximum_duplicate_timestamps": 0,
    "maximum_timestamp_resets": 0,
    "maximum_timestamp_missing_ratio": 0,
    "sample_rate_tolerance_ratio": 0.05,
    "maximum_gap_count_before_review": 0,
    "maximum_channel_missing_ratio": 0.01,
    "maximum_dropout_duration_ms_before_review": 50
  },
  "allowed_purposes": [
    "driver_coaching",
    "vehicle_performance",
    "model_training"
  ]
}
